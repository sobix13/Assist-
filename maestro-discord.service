[Unit]
Description=Maestro Discord owner interface
Wants=network-online.target maestro-agent.service
After=network-online.target maestro-agent.service
ConditionPathExists=/etc/maestro/frontend.env
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=maestro
Group=maestro
UMask=0077
WorkingDirectory=/opt/maestro/current
EnvironmentFile=/etc/maestro/frontend.env
ExecStart=/opt/maestro/current/.venv/bin/python main.py
Restart=on-failure
RestartSec=8
WatchdogSec=120
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/maestro /run/maestro
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
